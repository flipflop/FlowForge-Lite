# Copy to deploy/deploy.env (gitignored) and fill in. Never commit the real file.
AWS_PROFILE=your-profile
AWS_REGION=ap-southeast-2
EXPECTED_ACCOUNT=000000000000      # deploy.sh refuses to run against any other account
STACK_NAME=flowforge
# SSM prefix for optional server demo keys (written by deploy/set-secrets.sh)
SSM_PREFIX=/flowforge/prod
# Max concurrent API executions (spend cap) and per-IP demo-key LLM calls per hour
RESERVED_CONCURRENCY=5
RUNS_PER_HOUR=10
# ORIGIN_VERIFY_SECRET is generated by deploy.sh on first run and appended here.
# Optional custom domain (certificate must be in us-east-1):
HOST_NAME=
CERTIFICATE_ARN=
